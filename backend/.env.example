# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Local database (Postgres) ---
# When running via `docker compose up`, this is overridden to point at the
# `db` service automatically — only edit this for running the backend
# outside Docker against your own local Postgres.
DATABASE_URL=postgresql+psycopg://investment_tracker:investment_tracker@localhost:5432/investment_tracker

# --- Display / valuation ---
BASE_CURRENCY=EUR

# --- Interactive Brokers: TWS/IB Gateway ---
# Requires TWS or IB Gateway running locally (on your host machine, not in
# Docker) with API access enabled. Paper trading port is 7497, live is 7496.
# When running the backend via `docker compose up`, IBKR_HOST is overridden
# to `host.docker.internal` automatically so the container can reach it.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- Interactive Brokers: Flex Web Service (full trade history) ---
# Set up an Activity Flex Query in Account Management > Reports > Flex
# Queries, then generate a token under Settings > API > Flex Web Service.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# --- Refresh cadence ---
MARKET_DATA_REFRESH_MINUTES=15
SNAPSHOT_BUILD_HOUR_UTC=23

# --- OpenFIGI (security resolver — see plans/agentic_asset_mapping.md) ---
# Optional: raises the free-tier rate limit (https://www.openfigi.com/api).
# Only an ISIN is ever sent to OpenFIGI, never account/holding data.
OPENFIGI_API_KEY=

# --- Security resolver background job ---
RESOLVER_ENABLED=true
RESOLVER_INTERVAL_MINUTES=30
# Leave false until the model backend below is reachable with AGENT_MODEL
# pulled/available and supporting tool use — an ambiguous resolution with
# the agent "enabled" but nothing to run it just sits in NEEDS_AGENT
# instead of reaching a human in NEEDS_REVIEW.
AGENT_ENABLED=false

# --- security_resolver agent model backend (see
# plans/agentic_asset_mapping.md Phase 6 and ai/common/llm.py). Only read
# when AGENT_ENABLED=true. AGENT_PROVIDER picks the client and how
# AGENT_BASE_URL is interpreted:
#
#   ollama  -> AGENT_BASE_URL is Ollama's own root, e.g.
#              http://localhost:11434 (from docker compose, override to
#              http://host.docker.internal:11434 to reach Ollama on the
#              host — it isn't part of the compose stack). AGENT_API_KEY
#              is unused. AGENT_NUM_CTX sets the context window.
#   openai  -> AGENT_BASE_URL is any OpenAI-compatible API root INCLUDING
#              /v1, e.g. https://api.groq.com/openai/v1 for Groq, or
#              https://api.openai.com/v1 for OpenAI itself. AGENT_API_KEY
#              is the bearer token. AGENT_NUM_CTX is ignored.
#
# Switching models (qwen3:8b -> qwen3:14b, or to a hosted model on Groq) or
# providers is just editing these values — never a code change.
AGENT_PROVIDER=ollama
AGENT_BASE_URL=http://localhost:11434
AGENT_API_KEY=
AGENT_MODEL=qwen3:8b
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=180
AGENT_NUM_CTX=8192

# --- Quant Lab (see plans/quant_lab.md) ---
# Optional: a second, keyed daily-bar source used only to backfill Quant
# Lab calibration history when yfinance's persisted history is too short.
# Get a free key at https://twelvedata.com — only a symbol/MIC/date range
# is ever sent, never account/holding data. Leave blank to skip backfill
# (a model just reports "not enough history" for assets without enough
# already-persisted yfinance bars).
TWELVE_DATA_API_KEY=
