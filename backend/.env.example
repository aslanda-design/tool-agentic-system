# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Local database (Postgres) ---
# When running via `docker compose up`, this is overridden to point at the
# `db` service automatically — only edit this for running the backend
# outside Docker against your own local Postgres.
DATABASE_URL=postgresql+psycopg://investment_tracker:investment_tracker@localhost:5432/investment_tracker

# --- Display / valuation ---
BASE_CURRENCY=EUR

# --- Interactive Brokers: TWS/IB Gateway ---
# Requires TWS or IB Gateway running locally (on your host machine, not in
# Docker) with API access enabled. Paper trading port is 7497, live is 7496.
# When running the backend via `docker compose up`, IBKR_HOST is overridden
# to `host.docker.internal` automatically so the container can reach it.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- Interactive Brokers: Flex Web Service (full trade history) ---
# Set up an Activity Flex Query in Account Management > Reports > Flex
# Queries, then generate a token under Settings > API > Flex Web Service.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# --- Refresh cadence ---
MARKET_DATA_REFRESH_MINUTES=15
SNAPSHOT_BUILD_HOUR_UTC=23

# --- OpenFIGI (security resolver — see plans/agentic_asset_mapping.md) ---
# Optional: raises the free-tier rate limit (https://www.openfigi.com/api).
# Only an ISIN is ever sent to OpenFIGI, never account/holding data.
OPENFIGI_API_KEY=

# --- Security resolver background job ---
RESOLVER_ENABLED=true
RESOLVER_INTERVAL_MINUTES=30
# Leave false until the local-LLM agent (a later phase) actually exists —
# an ambiguous resolution with the agent "enabled" but no agent running
# just sits in NEEDS_AGENT instead of reaching a human in NEEDS_REVIEW.
AGENT_ENABLED=false
